# Copy to .env and fill values for your local environment
# SQL Server connection
DB_NAME=SuLiDB
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd
# DB_HOST for TCP connection, or DB_SERVER; for named instances (Windows) set DB_INSTANCE instead of relying on port
DB_HOST=localhost
DB_PORT=1433
# If using a named instance like SQLEXPRESS, set DB_INSTANCE=SQLEXPRESS and you may omit DB_PORT
DB_INSTANCE=
# Set to true if your SQL Server requires TLS/ENCRYPTION
DB_ENCRYPT=false

# JWT secret for signing tokens (set a real secret in production)
JWT_SECRET=dev_secret_fallback

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback
