# Backend Environment Variables for Production (Render)
# Set these in Render Dashboard > Environment Variables

# Frontend URL - URL mặc định stable (ít thay đổi)
FRONTEND_URL=https://suli-coffee-web.vercel.app

# Database Connection (already set in Render)
# DATABASE_URL=postgresql://...

# JWT Secret (already set in Render)  
# JWT_SECRET=your_jwt_secret

# Google OAuth (already set in Render)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=https://suli-coffee.onrender.com/auth/google/callback

# Backend URL for CSP middleware
BACKEND_URL=https://suli-coffee.onrender.com

# Port (Render auto-sets this)
# PORT=5000